<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_aiparsy" model="ir.ui.view">
        <field name="name">account.move.form.aiparsy</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_aiparsy_send" type="object" string="Recognize with AiParsy"
                        invisible="state != 'draft' or move_type not in ('in_invoice', 'in_refund') or aiparsy_document_id"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_aiparsy_open" type="object" class="oe_stat_button" icon="fa-magic"
                        invisible="not aiparsy_document_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">AiParsy</span>
                        <field name="aiparsy_status" class="o_stat_value" readonly="1"/>
                    </div>
                </button>
            </xpath>
            <xpath expr="//sheet" position="before">
                <field name="aiparsy_document_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_in_invoice_bill_tree_aiparsy" model="ir.ui.view">
        <field name="name">account.move.in_invoice.tree.aiparsy</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="aiparsy_status" optional="show" widget="badge"
                       decoration-info="aiparsy_status in ('sent', 'recognized')"
                       decoration-success="aiparsy_status in ('approved', 'filled')"
                       decoration-danger="aiparsy_status == 'error'"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter_aiparsy" model="ir.ui.view">
        <field name="name">account.move.select.aiparsy</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='draft']" position="after">
                <filter name="aiparsy" string="From AiParsy" domain="[('aiparsy_document_id', '!=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
